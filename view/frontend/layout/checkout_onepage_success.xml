<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <head>
        <css src="Vindi_Payment::css/vindi-success.css"/>
        <script src="Vindi_Payment::js/payments.js" />
    </head>

    <body>
        <referenceContainer name="content">
            <block class="Vindi\Payment\Block\Onepage\Bankslippix" name="checkout.success.vindi.bankslippix" template="onepage/bankslippix.phtml" cacheable="false"/>
            <block class="Vindi\Payment\Block\Onepage\Bankslip" name="checkout.success.vindi.bankslip" template="onepage/bankslip.phtml" cacheable="false"/>
            <block class="Vindi\Payment\Block\Onepage\Pix" name="checkout.success.vindi.pix" template="Vindi_Payment::onepage/pix.phtml" cacheable="false"/>
            <block class="Vindi\Payment\Block\Onepage\CreditCard" name="checkout.success.vindi.creditcard" template="Vindi_Payment::onepage/cc.phtml" cacheable="false"/>
            <block class="Vindi\Payment\Block\Onepage\CardBankslippix" name="checkout.success.vindi.cardbankslippix" template="Vindi_Payment::info/card_bankslippix.phtml" cacheable="false"/>
            <block class="Vindi\Payment\Block\Onepage\CardPix" name="checkout.success.vindi.cardpix" template="Vindi_Payment::info/card_pix.phtml" cacheable="false"/>
            <block class="Vindi\Payment\Block\Onepage\CardCard" name="checkout.success.vindi.cardcard" template="Vindi_Payment::info/card_card.phtml" cacheable="false"/>
        </referenceContainer>
    </body>
</page>
