<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="vindi_payment_process_order_creation_queue" instance="Vindi\Payment\Cron\ProcessOrderCreationQueue" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="vindi_payment_clean_old_logs" instance="Vindi\Payment\Cron\CleanOldLogs" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="vindi_payment_process_order_paid_queue" instance="Vindi\Payment\Cron\ProcessOrderPaidQueue" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="vindi_payment_clean_order_queue" instance="Vindi\Payment\Cron\CleanOrderQueue" method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
        <job name="vindi_payment_update_expired_links" instance="Vindi\Payment\Cron\UpdateExpiredLinks" method="execute">
            <schedule>30 3 * * *</schedule>
        </job>
        <job name="vindi_payment_cancel_orders_with_expired_links" instance="Vindi\Payment\Cron\CancelOrdersWithExpiredLinks" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="vindi_payment_process_webhook_bill_created" instance="Vindi\Payment\Cron\ProcessWebhookBillCreated" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="vindi_payment_process_webhook_bill_paid" instance="Vindi\Payment\Cron\ProcessWebhookBillPaid" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="vindi_payment_process_webhook_charge_rejected" instance="Vindi\Payment\Cron\ProcessWebhookChargeRejected" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="vindi_payment_process_webhook_charge_refunded" instance="Vindi\Payment\Cron\ProcessWebhookChargeRefunded" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="vindi_payment_process_webhook_bill_canceled" instance="Vindi\Payment\Cron\ProcessWebhookBillCanceled" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="vindi_payment_process_webhook_subscription" instance="Vindi\Payment\Cron\ProcessWebhookSubscription" method="execute">
            <schedule>*/2 * * * *</schedule>
        </job>
        <job name="vindi_payment_clean_webhook_queue" instance="Vindi\Payment\Cron\CleanWebhookQueue" method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
    </group>
</config>
