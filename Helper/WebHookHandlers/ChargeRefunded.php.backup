<?php
namespace Vindi\Payment\Helper\WebHookHandlers;

use Magento\Framework\Exception\LocalizedException;
use Psr\Log\LoggerInterface;
use Vindi\Payment\Model\PaymentSplitFactory;
use Magento\Sales\Api\OrderRepositoryInterface;
use Magento\Framework\Api\SearchCriteriaBuilder;
use Vindi\Payment\Helper\RefundHelper;
use Magento\Sales\Api\InvoiceRepositoryInterface;
use Magento\Sales\Model\Order\CreditmemoFactory;
use Magento\Sales\Model\Service\CreditmemoService;
use Magento\Framework\DB\Transaction;

/**
 * Class ChargeRefunded
 *
 * Handler for charge_refunded webhook.
 * Creates offline Credit Memo with proper values and items from the refunded charge.
 */
class ChargeRefunded
{
    protected $logger;
    protected $paymentSplitFactory;
    protected $orderRepository;
    protected $searchCriteriaBuilder;
    protected $refundHelper;
    protected $invoiceRepository;
    protected $creditmemoFactory;
    protected $creditmemoService;
    protected $transaction;

    public function __construct(
        LoggerInterface $logger,
        PaymentSplitFactory $paymentSplitFactory,
        OrderRepositoryInterface $orderRepository,
        SearchCriteriaBuilder $searchCriteriaBuilder,
        RefundHelper $refundHelper,
        InvoiceRepositoryInterface $invoiceRepository,
        CreditmemoFactory $creditmemoFactory,
        CreditmemoService $creditmemoService,
        Transaction $transaction
    ) {
        $this->logger = $logger;
        $this->paymentSplitFactory = $paymentSplitFactory;
        $this->orderRepository = $orderRepository;
        $this->searchCriteriaBuilder = $searchCriteriaBuilder;
        $this->refundHelper = $refundHelper;
        $this->invoiceRepository = $invoiceRepository;
        $this->creditmemoFactory = $creditmemoFactory;
        $this->creditmemoService = $creditmemoService;
        $this->transaction = $transaction;
    }

    public function chargeRefunded(array $data): bool
    {
        if (!isset($data['charge']) || empty($data['charge'])) {
            throw new LocalizedException(__('Charge data not found in webhook data.'));
        }

        $charge = $data['charge'];
        $chargeId = $charge['id'];
        $refundAmount = $charge['amount'] / 100; // Convert from cents to real value
        $billData = $data["bill"] ?? null;

        if (!$billData || !isset($billData['id'])) {
            $this->logger->warning('CHARGE_REFUNDED: No bill data found for charge ' . $chargeId);
            return true;
        }

        $billId = $billData['id'];
        $billCode = $billData['code'] ?? '';

        $this->logger->info('CHARGE_REFUNDED: Processing refunded charge ' . $chargeId);
        $this->logger->info('CHARGE_REFUNDED: Charge data - ' . json_encode([
            'charge_id' => $chargeId,
            'amount' => $refundAmount,
            'bill_id' => $billId,
            'bill_code' => $billCode,
            'payment_method' => $charge['payment_method']['code'] ?? 'unknown'
        ]));

        try {
            $order = $this->findOrderForBill($billCode);
            if (!$order) {
                $this->logger->warning('CHARGE_REFUNDED: Order not found for bill code: ' . $billCode);
                return false;
            }

            $creditmemo = $this->createOfflineCreditmemo($order, $charge, $billData);
            
            if ($creditmemo) {
                $commentText = sprintf(
                    'Estorno automático via webhook: Charge %d estornado (R$ %s) - Método: %s. Credit Memo #%s criado.',
                    $chargeId,
                    number_format($refundAmount, 2, ',', '.'),
                    $charge['payment_method']['name'] ?? 'Método de Pagamento',
                    $creditmemo->getIncrementId()
                );
                
                $order->addStatusHistoryComment($commentText);
                $this->orderRepository->save($order);
                
                $this->logger->info('CHARGE_REFUNDED: Credit Memo created successfully - Order: ' . 
                    $order->getIncrementId() . ', Credit Memo: ' . $creditmemo->getIncrementId());
            } else {
                $this->logger->error('CHARGE_REFUNDED: Failed to create Credit Memo for order: ' . $order->getIncrementId());
                return false;
            }

        } catch (\Exception $e) {
            $this->logger->error('CHARGE_REFUNDED: Error processing refund - ' . $e->getMessage());
            return false;
        }

        return true;
    }

    /**
     * Create offline Credit Memo with proper values and items
     *
     * @param \Magento\Sales\Model\Order $order
     * @param array $charge
     * @param array $billData
     * @return \Magento\Sales\Model\Order\Creditmemo|null
     */
    private function createOfflineCreditmemo($order, $charge, $billData)
    {
        try {
            if (!$order->canCreditmemo()) {
                $this->logger->warning('CHARGE_REFUNDED: Order cannot have creditmemo - Order: ' . $order->getIncrementId());
                return null;
            }

            // Get the first invoice
            $invoice = $order->getInvoiceCollection()->getFirstItem();
            if (!$invoice || !$invoice->getId()) {
                $this->logger->warning('CHARGE_REFUNDED: No invoice found for order: ' . $order->getIncrementId());
                return null;
            }

            $refundAmount = $charge['amount'] / 100; // Convert from cents
            
            // Determine if this is a partial or full refund
            $orderTotal = $order->getGrandTotal();
            $isFullRefund = abs($refundAmount - $orderTotal) < 0.01; // Allow for small rounding differences

            if ($isFullRefund) {
                // Full refund with all items
                $creditmemo = $this->createFullRefundCreditmemo($invoice, $charge);
            } else {
                // Partial refund with proportional items
                $creditmemo = $this->createPartialRefundCreditmemo($invoice, $charge, $refundAmount);
            }

            if ($creditmemo) {
                // Set as offline refund
                $creditmemo->setOfflineRequested(true);
                
                // Add comment with refund details
                $comment = sprintf(
                    'Estorno automático via Vindi webhook - Charge ID: %d, Valor: R$ %s, Método: %s',
                    $charge['id'],
                    number_format($refundAmount, 2, ',', '.'),
                    $charge['payment_method']['name'] ?? 'N/A'
                );
                $creditmemo->addComment($comment);

                // Save the creditmemo
                $this->creditmemoService->refund($creditmemo);

                return $creditmemo;
            }

        } catch (\Exception $e) {
            $this->logger->error('CHARGE_REFUNDED: Error creating creditmemo - ' . $e->getMessage());
            return null;
        }

        return null;
    }

    /**
     * Create full refund creditmemo with all items
     */
    private function createFullRefundCreditmemo($invoice, $charge)
    {
        $qtys = [];
        foreach ($invoice->getAllItems() as $item) {
            if ($item->getQty() > 0) {
                $qtys[$item->getOrderItemId()] = $item->getQty();
            }
        }

        return $this->creditmemoFactory->createByInvoice($invoice, [
            'qtys' => $qtys
        ]);
    }

    /**
     * Create partial refund creditmemo with proportional items
     */
    private function createPartialRefundCreditmemo($invoice, $charge, $refundAmount)
    {
        // For partial refunds, we'll create a creditmemo with adjusted amounts
        // but include all items with zero quantities to maintain structure
        $creditmemo = $this->creditmemoFactory->createByInvoice($invoice, []);

        // Set the refund amounts
        $creditmemo->setBaseGrandTotal($refundAmount);
        $creditmemo->setGrandTotal($refundAmount);
        $creditmemo->setBaseSubtotal($refundAmount);
        $creditmemo->setSubtotal($refundAmount);

        // Calculate tax proportion if there are taxes
        $originalSubtotal = $invoice->getSubtotal();
        $originalTax = $invoice->getTaxAmount();
        
        if ($originalSubtotal > 0 && $originalTax > 0) {
            $taxProportion = $originalTax / ($originalSubtotal + $originalTax);
            $refundTax = $refundAmount * $taxProportion;
            $refundSubtotal = $refundAmount - $refundTax;
            
            $creditmemo->setBaseSubtotal($refundSubtotal);
            $creditmemo->setSubtotal($refundSubtotal);
            $creditmemo->setBaseTaxAmount($refundTax);
            $creditmemo->setTaxAmount($refundTax);
        }

        return $creditmemo;
    }

    /**
     * Find order for bill using code pattern
     *
     * @param string $billCode
     * @return \Magento\Sales\Model\Order|null
     */
    private function findOrderForBill($billCode)
    {
        try {
            // Check if this is a multimethod bill (ends with -01, -02, etc.)
            if (strlen($billCode) >= 4 && preg_match('/-\d{2}$/', $billCode)) {
                // Extract base order increment ID
                $baseOrderIncrementId = preg_replace('/-\d{2}$/', '', $billCode);
                $suffix = substr($billCode, -3);

                $this->logger->info('CHARGE_REFUNDED: Detected multimethod pattern - Increment ID: ' . $baseOrderIncrementId . ', Suffix: ' . $suffix . ' from bill: ' . $billCode);

                $searchCriteria = $this->searchCriteriaBuilder
                    ->addFilter('increment_id', $baseOrderIncrementId)
                    ->addFilter('state', ['new', 'processing', 'complete', 'canceled'], 'in')
                    ->create();

                $orders = $this->orderRepository->getList($searchCriteria)->getItems();

                if (!empty($orders)) {
                    $order = reset($orders);
                    $this->logger->info('CHARGE_REFUNDED: Found order ' . $order->getIncrementId() . ' for multimethod bill ' . $billCode);
                    return $order;
                }

                $this->logger->warning('CHARGE_REFUNDED: No order found with increment_id: ' . $baseOrderIncrementId . ' for bill: ' . $billCode);
            } else {
                // Try to find order by exact bill code match
                $searchCriteria = $this->searchCriteriaBuilder
                    ->addFilter('increment_id', $billCode)
                    ->addFilter('state', ['new', 'processing', 'complete', 'canceled'], 'in')
                    ->create();

                $orders = $this->orderRepository->getList($searchCriteria)->getItems();

                if (!empty($orders)) {
                    $order = reset($orders);
                    $this->logger->info('CHARGE_REFUNDED: Found order ' . $order->getIncrementId() . ' for bill ' . $billCode);
                    return $order;
                }

                $this->logger->info('CHARGE_REFUNDED: No direct match found for bill code: ' . $billCode);
            }

            return null;

        } catch (\Exception $e) {
            $this->logger->error('CHARGE_REFUNDED: Error finding order - ' . $e->getMessage());
            return null;
        }
    }
}
